# Copy this file to .env:   cp .env.example .env
# The values below are for a local demo only. For anything else, make your own, e.g.:
#   openssl rand -hex 32

# --- PostgreSQL ---
POSTGRES_USER=tickets
POSTGRES_PASSWORD=local-demo-postgres-password
POSTGRES_DB=tickets
# How the programs reach the database inside Docker (the host name is the service name "postgres").
# The user, password and database name must be the same as above.
DATABASE_URL=postgres://tickets:local-demo-postgres-password@postgres:5432/tickets

# --- Redis ---
REDIS_PASSWORD=local-demo-redis-password
# The password here must be the same as above.
REDIS_URL=redis://:local-demo-redis-password@redis:6379

# --- Demo users created by the seed (listed in the README) ---
SEED_ADMIN_PASSWORD=Admin-Demo-Pass-1
SEED_ALICE_PASSWORD=Alice-Demo-Pass-1
SEED_BOB_PASSWORD=Bob-Demo-Pass-1

# --- Other ---
LOG_LEVEL=info
# Open the site at http://localhost:8080 (change the number if the port is taken)
WEB_HOST_PORT=8080
